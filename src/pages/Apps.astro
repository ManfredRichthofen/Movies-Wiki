---
import CustomPageLayout from '../layouts/CustomPageLayout.astro';
import Apps from '../components/pages/Apps';
import { getLatestAPKReleaseInfo } from '../utils/github';

const releaseInfo = await getLatestAPKReleaseInfo();
---

<CustomPageLayout title="YouTube apps" description="Ad-free YouTube and YouTube Music for Android — install the helper first, then the apps.">
  <Apps releaseInfo={releaseInfo} />
</CustomPageLayout>
